{
    "name": "@ethio-commerce/api",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "node --env-file=../../.env dist/index.js",
        "build": "tsc",
        "start": "node dist/index.js",
        "test": "vitest run",
        "platform-auth:create-user": "node --env-file=../../.env ../../node_modules/tsx/dist/cli.mjs src/scripts/create-platform-user.ts",
        "billing:process-overdue": "node --env-file=../../.env ../../node_modules/tsx/dist/cli.mjs src/scripts/process-overdue-invoices.ts",
        "merchant:process-invitations": "node dist/scripts/process-merchant-invitations.js",
        "ai:evaluate-multilingual": "node --env-file=../../.env ../../node_modules/tsx/dist/cli.mjs src/scripts/evaluate-multilingual-ai.ts"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.117.1",
        "@aws-sdk/client-s3": "^3.1115.0",
        "@ethio-commerce/database": "^0.1.0",
        "@google/genai": "^2.17.1",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.6.2",
        "multer": "^2.2.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/multer": "^2.2.0",
        "@types/node": "^26.2.0",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2",
        "vitest": "4.1.12"
    }
}
