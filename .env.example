# ============================================================
# Ethio Social Commerce — Environment Configuration
# ============================================================
#
# Copy this file to .env for local development:
#
#   Copy-Item .env.example .env
#
# NEVER put real credentials in this file.
# NEVER commit .env to Git.
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

NODE_ENV=development
API_PORT=3000

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ethio_social_commerce?schema=public

# ------------------------------------------------------------
# AI Providers
# ------------------------------------------------------------

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------
# Telegram
# ------------------------------------------------------------

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# The merchant that owns the Telegram bot configured above.
TELEGRAM_MERCHANT_ID=

# ------------------------------------------------------------
# TikTok
# ------------------------------------------------------------

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Application Security
# ------------------------------------------------------------

# Merchant authentication token signing secret.
# Must contain at least 32 characters.
AUTH_SECRET=

# Platform administrator authentication token signing secret.
# Must contain at least 32 characters and must differ from AUTH_SECRET.
PLATFORM_AUTH_SECRET=

# Authentication token lifetime in seconds.
# Allowed range: 300-604800. Default: 86400.
AUTH_TOKEN_TTL_SECONDS=86400

# Delivery confirmation signing secret.
# Must contain at least 32 characters.
DELIVERY_CONFIRMATION_SECRET=
