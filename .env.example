# ============================================================
# Ethio Social Commerce — Environment Configuration
# ============================================================
#
# Copy this file to .env for local development:
#
#   Copy-Item .env.example .env
#
# NEVER put real credentials in this file.
# NEVER commit .env to Git.
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

NODE_ENV=development
API_PORT=3000

# Browser origins allowed to call the API, separated by commas.
# Production deployments must set this to the exact HTTPS dashboard origin(s).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Public API base URL embedded into the Vite web build.
# Production deployments must set this to the externally reachable API origin.
VITE_API_BASE_URL=http://localhost:3000

# Public API origin used by the backend to construct external callback URLs.
# Production deployments must set this to the externally reachable HTTPS API origin.
# Telegram webhook provisioning requires this value.
PUBLIC_API_BASE_URL=http://localhost:3000

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ethio_social_commerce?schema=public

# ------------------------------------------------------------
# AI Providers
# ------------------------------------------------------------

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------
# Telegram
# ------------------------------------------------------------

# Encryption key for persisted merchant Telegram credentials.
# Must contain at least 32 characters and must be separate from authentication secrets.
TELEGRAM_CREDENTIAL_ENCRYPTION_KEY=

# ------------------------------------------------------------
# Cloudflare R2 Storage
# ------------------------------------------------------------

# Shared Cloudflare R2 account credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Product and customer receipt image storage.
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Private merchant settlement receipt storage.
R2_SETTLEMENT_BUCKET_NAME=

# ------------------------------------------------------------
# TikTok (reserved for planned integration; not currently used at runtime)
# ------------------------------------------------------------

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Application Security
# ------------------------------------------------------------

# Merchant authentication token signing secret.
# Must contain at least 32 characters.
AUTH_SECRET=

# Platform administrator authentication token signing secret.
# Must contain at least 32 characters and must differ from AUTH_SECRET.
PLATFORM_AUTH_SECRET=

# Authentication token lifetime in seconds.
# Allowed range: 300-604800. Default: 86400.
AUTH_TOKEN_TTL_SECONDS=86400

# Delivery confirmation signing secret.
# Must contain at least 32 characters.
DELIVERY_CONFIRMATION_SECRET=

# ------------------------------------------------------------
# Merchant Owner Activation & Invitation Delivery
# ------------------------------------------------------------

# Encryption key for merchant invitation tokens stored in the delivery outbox.
# Must contain at least 32 characters and differ from authentication secrets.
# The API and invitation worker must use the same key.
MERCHANT_INVITATION_ENCRYPTION_KEY=

# Public HTTPS URL of the merchant owner activation page.
# Local development example:
# MERCHANT_ACTIVATION_BASE_URL=http://localhost:5173/activate-owner
MERCHANT_ACTIVATION_BASE_URL=

# Resend API key used to send merchant owner invitations.
RESEND_API_KEY=

# Verified sender address configured in Resend.
# Example: Ethio Social Commerce <invitations@example.com>
RESEND_FROM_EMAIL=
