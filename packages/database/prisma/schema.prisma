generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum MerchantUserRole {
  OWNER
  ADMIN
  STAFF
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAYMENT_REVIEW
  PAID
  FULFILLING
  FULFILLED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  REVIEW_REQUIRED
  VERIFIED
  REJECTED
  DUPLICATE
}

enum PaymentProvider {
  TELEBIRR
  CBE_BIRR
  OTHER
}

enum PaymentMethodStatus {
  ACTIVE
  INACTIVE
}

enum ConversationChannel {
  TELEGRAM
}

enum MerchantTelegramIntegrationStatus {
  ACTIVE
  INACTIVE
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MerchantSubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum SubscriptionBillingInterval {
  MONTHLY
  ANNUAL
}

enum MerchantAccountStatus {
  ACTIVE
  SUSPENDED
}

enum CommissionStatus {
  ACCRUED
  INVOICED
  PAID
  WAIVED
}

enum CommissionAdjustmentType {
  REVERSAL
  REFUND
  WAIVER
  CORRECTION
}

enum MerchantInvoiceStatus {
  DRAFT
  OPEN
  PAID
  OVERDUE
  VOID
}

enum MerchantInvoiceItemType {
  SUBSCRIPTION
  COMMISSION
  ADJUSTMENT
}

enum MerchantInvoiceReminderType {
  FIRST_OVERDUE
  SECOND_OVERDUE
}

enum MerchantSettlementStatus {
  REVIEW_REQUIRED
  VERIFIED
  REJECTED
}

enum MerchantSettlementProvider {
  TELEBIRR
  CBE_BIRR
  OTHER
}

model Merchant {
  id             String   @id @default(cuid())
  name           String
  currency       String   @default("ETB") @db.VarChar(3)
  phone          String?
  alternatePhone String?
  address                 String?
  accountStatus           MerchantAccountStatus @default(ACTIVE)
  accountSuspensionReason String?
  accountSuspendedAt      DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  users          MerchantUser[]
  customers      Customer[]
  products       Product[]
  categories     ProductCategory[]
  orders         Order[]
  payments       Payment[]
  paymentMethods PaymentMethod[]
  telegramIntegration MerchantTelegramIntegration?
  conversations  Conversation[]
  webhookEvents  WebhookEvent[]
  auditLogs      AuditLog[]

  subscription          MerchantSubscription?
  commissions           Commission[]
  commissionAdjustments CommissionAdjustment[]
  invoices              MerchantInvoice[]
  invoiceItems          MerchantInvoiceItem[]
  invoiceReminders      MerchantInvoiceReminder[]
  settlements           MerchantSettlement[]
}

model MerchantUser {
  id           String           @id @default(cuid())
  merchantId   String
  email        String           @unique
  passwordHash String
  displayName  String?
  role         MerchantUserRole @default(OWNER)
  tokenVersion Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model Customer {
  id             String   @id @default(cuid())
  merchantId     String
  name           String?
  phone          String?
  telegramChatId String?
  telegramUserId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orders        Order[]
  conversations Conversation[]

  @@unique([merchantId, telegramChatId])
  @@unique([merchantId, telegramUserId])
  @@index([merchantId, phone])
}

model Product {
  id          String        @id @default(cuid())
  merchantId  String
  categoryId  String?
  name        String
  description String?
  price       Decimal       @db.Decimal(12, 2)
  currency    String        @default("ETB") @db.VarChar(3)
  stock       Int           @default(0)
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  merchant   Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images     ProductImage[]
  orderItems OrderItem[]

  @@index([merchantId, status])
  @@index([merchantId, categoryId])
}

model ProductCategory {
  id           String   @id @default(cuid())
  merchantId   String
  name         String
  imageUrl     String?
  imageAltText String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  merchant Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([merchantId, name])
  @@index([merchantId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Order {
  id          String      @id @default(cuid())
  merchantId  String
  customerId  String?
  orderNumber String
  status      OrderStatus @default(DRAFT)
  currency    String      @default("ETB") @db.VarChar(3)
  subtotal    Decimal     @db.Decimal(12, 2)
  total       Decimal     @db.Decimal(12, 2)

  deliveryName                      String?
  deliveryPhone                     String?
  deliveryAddress                   String?
  deliveryConfirmationCodeHash      String?
  deliveryConfirmationCodeExpiresAt DateTime?
  deliveryConfirmationAttempts      Int       @default(0)
  deliveryConfirmationSentAt        DateTime?
  deliveryConfirmedAt               DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant    Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  payments    Payment[]
  commissions Commission[]

  @@unique([id, merchantId])
  @@unique([merchantId, orderNumber])
  @@index([merchantId, status, createdAt])
  @@index([customerId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                   String          @id @default(cuid())
  merchantId           String
  orderId              String
  provider             PaymentProvider
  status               PaymentStatus   @default(PENDING)
  amount               Decimal         @db.Decimal(12, 2)
  currency             String          @default("ETB") @db.VarChar(3)
  transactionReference String?
  receiptUrl           String?
  receiptMetadata      Json?
  reviewNote           String?
  verifiedAt           DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  merchant   Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  commission Commission?

  @@unique([provider, transactionReference])
  @@unique([id, merchantId])
  @@index([merchantId, status, createdAt])
  @@index([orderId])
}

model PaymentMethod {
  id            String              @id @default(cuid())
  merchantId    String
  provider      PaymentProvider
  accountName   String
  accountNumber String
  status        PaymentMethodStatus @default(ACTIVE)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, provider])
  @@index([merchantId, status])
}

model MerchantTelegramIntegration {
  id                     String                            @id @default(cuid())
  merchantId             String                            @unique
  webhookKey             String                            @unique
  botTokenEncrypted      String
  webhookSecretEncrypted String
  status                 MerchantTelegramIntegrationStatus @default(ACTIVE)
  createdAt              DateTime                          @default(now())
  updatedAt              DateTime                          @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([status])
}

model SubscriptionPlan {
  id             String   @id @default(cuid())
  code           String   @unique @db.VarChar(50)
  name           String
  monthlyPrice   Decimal  @db.Decimal(12, 2)
  annualPrice    Decimal  @db.Decimal(12, 2)
  currency       String   @default("ETB") @db.VarChar(3)
  commissionRate Decimal  @db.Decimal(7, 6)
  features       Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions MerchantSubscription[]

  @@index([isActive])
}

model MerchantSubscription {
  id                     String                      @id @default(cuid())
  merchantId             String                      @unique
  planId                 String
  status                 MerchantSubscriptionStatus
  billingInterval        SubscriptionBillingInterval
  priceSnapshot          Decimal                     @db.Decimal(12, 2)
  commissionRateSnapshot Decimal                     @db.Decimal(7, 6)
  currency               String                      @default("ETB") @db.VarChar(3)
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  trialEndsAt            DateTime?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  merchant     Merchant              @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  plan         SubscriptionPlan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  commissions  Commission[]
  invoiceItems MerchantInvoiceItem[]

  @@unique([id, merchantId])
  @@index([planId])
  @@index([status, currentPeriodEnd])
}

model Commission {
  id             String @id @default(cuid())
  merchantId     String
  paymentId      String @unique
  orderId        String
  subscriptionId String

  transactionAmount Decimal @db.Decimal(12, 2)
  commissionRate    Decimal @db.Decimal(7, 6)
  commissionAmount  Decimal @db.Decimal(12, 2)
  currency          String  @default("ETB") @db.VarChar(3)

  status    CommissionStatus @default(ACCRUED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  merchant     Merchant               @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  payment      Payment                @relation(fields: [paymentId, merchantId], references: [id, merchantId], onDelete: Restrict)
  order        Order                  @relation(fields: [orderId, merchantId], references: [id, merchantId], onDelete: Restrict)
  subscription MerchantSubscription   @relation(fields: [subscriptionId, merchantId], references: [id, merchantId], onDelete: Restrict)
  invoiceItem  MerchantInvoiceItem?
  adjustments  CommissionAdjustment[]

  @@unique([paymentId, merchantId])
  @@unique([id, merchantId])
  @@index([merchantId, status, createdAt])
  @@index([orderId])
  @@index([subscriptionId])
}

model CommissionAdjustment {
  id           String @id @default(cuid())
  merchantId   String
  commissionId String

  type CommissionAdjustmentType

  amount   Decimal @db.Decimal(12, 2)
  currency String  @db.VarChar(3)

  reason String

  idempotencyKey String

  createdAt DateTime @default(now())

  merchant    Merchant             @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  commission  Commission           @relation(fields: [commissionId, merchantId], references: [id, merchantId], onDelete: Restrict)
  invoiceItem MerchantInvoiceItem?

  @@unique([merchantId, idempotencyKey])
  @@unique([id, merchantId])
  @@index([commissionId])
  @@index([merchantId, createdAt])
}

model MerchantInvoice {
  id            String @id @default(cuid())
  merchantId    String
  invoiceNumber String

  periodStart DateTime
  periodEnd   DateTime

  subscriptionAmount Decimal @db.Decimal(12, 2)
  commissionAmount   Decimal @db.Decimal(12, 2)
  totalAmount        Decimal @db.Decimal(12, 2)
  currency           String  @default("ETB") @db.VarChar(3)

  status MerchantInvoiceStatus @default(DRAFT)

  dueAt    DateTime?
  openedAt DateTime?
  paidAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant    Merchant                  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  items       MerchantInvoiceItem[]
  reminders   MerchantInvoiceReminder[]
  settlements MerchantSettlement[]

  @@unique([merchantId, invoiceNumber])
  @@unique([merchantId, periodStart, periodEnd])
  @@unique([id, merchantId])
  @@index([merchantId, status, createdAt])
  @@index([merchantId, dueAt])
}

model MerchantInvoiceItem {
  id          String                  @id @default(cuid())
  merchantId  String
  invoiceId   String
  type        MerchantInvoiceItemType
  description String

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("ETB") @db.VarChar(3)

  commissionId   String?
  adjustmentId   String?
  subscriptionId String?

  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?

  metadata Json?

  createdAt DateTime @default(now())

  merchant     Merchant              @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  invoice      MerchantInvoice       @relation(fields: [invoiceId, merchantId], references: [id, merchantId], onDelete: Restrict)
  commission   Commission?           @relation(fields: [commissionId, merchantId], references: [id, merchantId], onDelete: Restrict)
  adjustment   CommissionAdjustment? @relation(fields: [adjustmentId, merchantId], references: [id, merchantId], onDelete: Restrict)
  subscription MerchantSubscription? @relation(fields: [subscriptionId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([commissionId])
  @@unique([commissionId, merchantId])
  @@unique([adjustmentId])
  @@unique([adjustmentId, merchantId])
  @@unique([subscriptionId, billingPeriodStart, billingPeriodEnd])
  @@index([merchantId, invoiceId])
  @@index([type])
  @@index([subscriptionId])
}

model MerchantInvoiceReminder {
  id         String                      @id @default(cuid())
  merchantId String
  invoiceId  String
  type       MerchantInvoiceReminderType

  createdAt DateTime @default(now())

  merchant Merchant        @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  invoice  MerchantInvoice @relation(fields: [invoiceId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([invoiceId, type])
  @@index([merchantId, createdAt])
  @@index([invoiceId, createdAt])
}

model MerchantSettlement {
  id         String @id @default(cuid())
  merchantId String
  invoiceId  String

  provider MerchantSettlementProvider
  status   MerchantSettlementStatus   @default(REVIEW_REQUIRED)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("ETB") @db.VarChar(3)

  idempotencyKey       String  @db.VarChar(200)
  transactionReference String?
  receiptUrl           String?
  receiptMetadata      Json?
  reviewNote           String?

  submittedAt DateTime  @default(now())
  verifiedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant Merchant        @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  invoice  MerchantInvoice @relation(fields: [invoiceId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([merchantId, idempotencyKey])
  @@unique([provider, transactionReference])
  @@index([merchantId, status, createdAt])
  @@index([invoiceId])
}

model Conversation {
  id         String              @id @default(cuid())
  merchantId String
  customerId String?
  channel    ConversationChannel
  externalId String
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  merchant Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages Message[]

  @@unique([merchantId, channel, externalId])
  @@index([customerId])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection
  externalId     String?
  content        String?
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, externalId])
  @@index([conversationId, createdAt])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  merchantId  String?
  provider    String
  eventId     String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  merchant Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@unique([merchantId, provider, eventId])
  @@index([merchantId, receivedAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  merchantId  String
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, entityType, entityId])
}

model PlatformUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs PlatformAuditLog[]
}

model PlatformAuditLog {
  id                  String   @id @default(cuid())
  actorPlatformUserId String
  merchantId          String?
  action              String
  entityType          String
  entityId            String
  metadata            Json?
  createdAt           DateTime @default(now())

  actor PlatformUser @relation(fields: [actorPlatformUserId], references: [id], onDelete: Restrict)

  @@index([actorPlatformUserId, createdAt])
  @@index([merchantId, createdAt])
  @@index([entityType, entityId])
}
